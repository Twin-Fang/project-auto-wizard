---
// Autoplaying demo video. Default: the install demo in public/demo/ (base path keeps it working under the Pages sub-path).
// src/poster: URLs of another video, e.g. imported from assets/demo/ with `?url`
interface Props {
  label: string;
  src?: string;
  poster?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { label, src = `${base}/demo/install.mp4`, poster = `${base}/demo/install-poster.jpg` } = Astro.props;
---

<figure class="demo-video">
  <video
    src={src}
    poster={poster}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-label={label}
    width="1200"
    height="760"
  ></video>
</figure>

<style>
  .demo-video {
    margin: 0;
  }
  .demo-video video {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    background: #0d1117;
  }
</style>

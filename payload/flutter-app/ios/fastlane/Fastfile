# ===================================================================
# This file is user-owned. Edit the per-mode behavior here.
# ===================================================================
#
# Fastfile template for iOS deployment. After the Flutter workflow builds the IPA, it runs
# `cd ios && bundle exec fastlane <lane>`.
# project-auto-wizard does not overwrite this file if it already exists, so feel free to edit it.
#
# Lanes
#   deploy              PROJECT-FLUTTER-IOS-TESTFLIGHT workflow (branches on DEPLOY_MODE)
#   upload_testflight   PROJECT-FLUTTER-IOS-TEST-TESTFLIGHT workflow (only uploads the IPA to TestFlight)
#
# Deploy modes of the deploy lane (passed by the workflow via the DEPLOY_MODE environment variable)
# +---------------+--------------------------------------------------------------+
# | DEPLOY_MODE   | Behavior                                                     |
# +---------------+--------------------------------------------------------------+
# | store_only    | Up to the TestFlight upload (upload_to_testflight)           |
# | store_prepare | After the TestFlight upload, prepare the App Store version   |
# |               | and metadata (upload_to_app_store, submit_for_review: false).|
# |               | The build is not attached to the version at this stage; it   |
# |               | is attached and submitted in one go when store_submit calls  |
# |               | this again with build_number.                                |
# | store_submit  | Same call as store_prepare, but also submits for review      |
# |               | (submit_for_review: true; the build is attached to the       |
# |               | version at this point)                                       |
# +---------------+--------------------------------------------------------------+
# Unknown or empty values are treated as store_only.
#
# Environment variables passed by the workflow
#   APP_STORE_CONNECT_API_KEY_ID   App Store Connect API Key ID
#   APP_STORE_CONNECT_ISSUER_ID    App Store Connect Issuer ID
#   API_KEY_PATH                   Path to the AuthKey_XXXX.p8 file
#   IPA_PATH                       Absolute path of the .ipa to upload
#   RELEASE_NOTES                  TestFlight "What to Test" text (changelog)
#   APP_IDENTIFIER                 Bundle ID (the upload_testflight lane lets fastlane infer it if missing,
#                                  but store_prepare/store_submit in the deploy lane require it)
#   DEPLOY_MODE                    Deploy mode from the table above (deploy lane only)
#   APP_VERSION, BUILD_NUMBER      App version and build number (deploy lane only)
#   SKIP_WAITING_FOR_BUILD_PROCESSING  If "true", do not wait for build processing (store_only only)
#
# Notes
# - store_prepare/store_submit must attach the build to the App Store version, so they wait until
#   build processing finishes (SKIP_WAITING_FOR_BUILD_PROCESSING is ignored).
# - Screenshots are not uploaded. Metadata is uploaded only when files exist under ios/fastlane/metadata/.
#   Fill in required items such as "What's New" in that folder or in App Store Connect before submitting for review.
# - If store_submit fails on export compliance, set ITSAppUsesNonExemptEncryption in Info.plist or
#   add submission_information to upload_to_app_store.
# - store_submit does not auto-release after review approval (automatic_release: false).

default_platform(:ios)

# Look up a user-facing message in the installed catalog so it follows `language` in version.yml.
# Finds the repo root by walking up to .github/scripts/messages.py (it reads ./version.yml from there);
# falls back to the key when the catalog is unavailable (for example when fastlane runs on a laptop).
def paw_msg(key, **params)
  root = Dir.pwd
  root = File.dirname(root) until File.exist?(File.join(root, ".github", "scripts", "messages.py")) || root == File.dirname(root)
  out = IO.popen(["python3", File.join(root, ".github", "scripts", "messages.py"), "get", key, *params.map { |k, v| "#{k}=#{v}" }], chdir: root, err: File::NULL, &:read)
  $?.success? && !out.to_s.strip.empty? ? out.chomp : key
rescue StandardError
  key
end

def require_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!(paw_msg("fastlane.env_empty", name: name)) if value.empty?
  value
end

def load_api_key
  app_store_connect_api_key(
    key_id: require_env("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: require_env("APP_STORE_CONNECT_ISSUER_ID"),
    key_filepath: require_env("API_KEY_PATH")
  )
end

# Include APP_IDENTIFIER in the options only when set; otherwise leave it to fastlane's default inference.
def app_identifier_option
  app_identifier = ENV["APP_IDENTIFIER"].to_s.strip
  app_identifier.empty? ? {} : { app_identifier: app_identifier }
end

def upload_ipa_to_testflight(api_key, skip_waiting_for_build_processing)
  options = {
    api_key: api_key,
    ipa: require_env("IPA_PATH"),
    skip_waiting_for_build_processing: skip_waiting_for_build_processing
  }
  release_notes = ENV["RELEASE_NOTES"].to_s.strip
  options[:changelog] = release_notes unless release_notes.empty?
  upload_to_testflight(**options, **app_identifier_option)
end

platform :ios do
  desc "Uploads the IPA to TestFlight (for test builds)"
  lane :upload_testflight do
    upload_ipa_to_testflight(load_api_key, false)
  end

  desc "Uploads the IPA and, depending on DEPLOY_MODE, proceeds to TestFlight / review preparation / review submission"
  lane :deploy do
    api_key = load_api_key
    deploy_mode = ENV["DEPLOY_MODE"].to_s.strip

    case deploy_mode
    when "store_prepare", "store_submit"
      UI.message(paw_msg("fastlane.ios_prepare_wait", deploy_mode: deploy_mode))
      upload_ipa_to_testflight(api_key, false)

      upload_to_app_store(
        api_key: api_key,
        app_identifier: require_env("APP_IDENTIFIER"),
        app_version: require_env("APP_VERSION"),
        build_number: require_env("BUILD_NUMBER"),
        skip_binary_upload: true,
        skip_screenshots: true,
        skip_metadata: Dir.glob("metadata/*").empty?,
        submit_for_review: deploy_mode == "store_submit",
        automatic_release: false,
        force: true,
        precheck_include_in_app_purchases: false
      )
    when "store_only"
      upload_ipa_to_testflight(api_key, ENV["SKIP_WAITING_FOR_BUILD_PROCESSING"].to_s.strip.downcase == "true")
    else
      UI.important(paw_msg("fastlane.deploy_mode_unknown", deploy_mode: deploy_mode)) unless deploy_mode.empty?
      upload_ipa_to_testflight(api_key, ENV["SKIP_WAITING_FOR_BUILD_PROCESSING"].to_s.strip.downcase == "true")
    end
  end
end
